{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visusic.dev/schemas/widget-manifest.schema.json",
  "title": "VisuSic widget manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "params", "render"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "$ref": "#/$defs/localizedText" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "requires": {
      "type": "object",
      "properties": {
        "audio": { "type": "boolean" },
        "lyrics": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "default": { "type": "string" },
        "resizable": { "type": "boolean" },
        "aspectLock": { "type": "boolean" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "additionalProperties": false
    },
    "params": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "expressions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "render": { "$ref": "#/$defs/render" }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["id", "type", "label", "default"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "float", "int", "bool", "enum", "color", "gradient", "font",
            "text", "multiline", "image", "choiceCards", "vector2",
            "range", "curveEditor", "group"
          ]
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "default": true,
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "primary": { "type": "boolean" },
        "group": { "type": "string" }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["id", "feature"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "attack": { "type": "integer", "minimum": 0 },
        "release": { "type": "integer", "minimum": 0 },
        "curve": { "enum": ["linear", "ease", "expo"] }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["native", "shader", "composite"] },
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "nodes": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
